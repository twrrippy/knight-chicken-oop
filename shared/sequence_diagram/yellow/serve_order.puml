@startuml SequenceDiagram
skinparam maxmessagesize 300

actor Customer
participant Restaurant
participant Order
participant OrderItem

Customer -> Restaurant : serve(order_id, token)
activate Restaurant

== Authentication ==
Restaurant -> Restaurant : verify_token_and_role(token, [UserRole.ADMIN, UserRole.STAFF])
activate Restaurant

alt session_obj is None OR role not in ["admin", "staff"]
    Restaurant --x Customer : return "Unable to proceed: Invalid token or missing permission"
    deactivate Restaurant
else Authorized
    
    == Retrieve Entities ==
    Restaurant -> Restaurant : search_order_from_id(order_id)
    activate Restaurant
    Restaurant --> Restaurant : return target_order
    deactivate Restaurant
    
    == Serve Order ==
    Restaurant -> Order : serve()
    activate Order
    
    alt status != OrderStatus.READY
        Order --x Customer : raise ValueError("Status is not READY")
    else status == OrderStatus.READY
        Order -> Order : self.status = OrderStatus.SERVED
        
        loop for item in self.__order_item_list
            Order -> OrderItem : item.status = OrderItemStatus.SERVED
            activate OrderItem
            OrderItem --> Order : updated
            deactivate OrderItem
        end
        
        Order --> Restaurant : return order
        deactivate Order
        
        == Response Formatting ==
        Restaurant -> Order : order_to_dict()
        activate Order
        Order --> Restaurant : order_dict
        deactivate Order
        
        Restaurant --> Customer : return order_dict
        deactivate Restaurant
    end
end


@enduml