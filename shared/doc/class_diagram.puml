@startuml ClassDiagram

class Restaurant{
    - member : list of Member
    - order_list : list of Order <in comfirm, paided, and cooking state>
    - coupon_list : list of Coupon
    - stock_log : list of StockLog
    - transaction_log : list of Transaction
    - room : list of Room
    - staff : list of Staff
    - stock : Stock
    - menu : list of MenuFood
    - payment_gateway : PaymentStrategy
    - delivery_platform : DeliveryPlatform
    - booking_list : list of Booking
    + add_coupon(Coupon)
    + get_coupon_by_code(code)
    - create_transaction()
    + booking_room(staff_id, member_id, room_id, amount_paid, start_time, hours)
    + add_booking()
    + is_slot_available(room, start, hours)
    + auto_check_no_show()
    + get_bookings_by_status(status): List[Booking]
    + get_booking_by_id(booking_id)
}
Customer --|> User
Staff --|> User
class User{
    - id : string
    - name : string
    - phoneNumber : string
    + get_id()
}
Restaurant o-- Member
Member--|>Customer
Guest--|>Customer
class Customer {
    <<Abstract>>
    + request_bill()
}
class Guest {
    + register()
}
class Member{
    - coupon_list : list[Coupon]
    - receipt_list : list[Recipt]
    - tier : MemberTier
    + add_receipt(receipt)
    + add_coupon(Coupon)
}

Restaurant o-- Staff
FrontStaff--|>Staff
PartyStaff--|>Staff
KitchenStaff--|>Staff
Manager--|>FrontStaff
Manager--|>PartyStaff
Manager--|>KitchenStaff
class Staff{
    <<Abstract>>
    - username
    - password
    + login()
    + logout()
}
class FrontStaff{
    + create_order()
    
}
class PartyStaff{
    + check_room_availability(room, slot)
    + check_in_booking(booking_id)
    + check_out_booking(booking_id)
}
class KitchenStaff{
    + view_queue()
    + update_food_status()
    + report_waste()   
}
class Manager{
    + void_bill()
}

DineInOrder --|> Order
EventOrder --|> Order
DeliveryOrder --|> Order

class DineInOrder{
    
}
class EventOrder{
    - booking : Booking
    + booking() : Booking
    + pre_calculate_totals(coupon: Coupon)
    + get_bill_info()
}
class DeliveryOrder{
    - delivery_status : finding_driver, driver_assigned, driver_at _store, out_for_delivery, delivered
    + update_status(DeliveryStatus)
    + pre_calculate_totals(coupon: Coupon)
}

Restaurant o-- Order
Order *-- Food
Order --> Customer
Food --> Particular
Particular o-- Ingredient
Ingredient --> Item

abstract class Order{
    - id:  string
    - type : DineIn, Event, Delivery
    - customer : Customer
    - food_list : list Food
    - sub_total_price : float
    - status_start : datetime
    - discount : float
    - final_price : float
    - status : none, reserved, confirmed, paided, cooking, finish, served, cancle
    + update_status(OrderStatus)
    + pre_calculate_totals(coupon: Coupon)
    + calculate_totals(coupon: Coupon)
    + get_bill_info()
}
class Food{
    - particular : Particular
    - quantity : int
    - status : FoodStatus
    + update_status(FoodStatus)
    + get_details() : Dict<str, Any>
}
class Particular{
    - name : str
    - recipe : list of Ingredient
    - price : float
    - cooking_time : datetime
    + get_all_ingredient()
}
Burger --|> Particular
ChickenSet --|> Particular
class Burger{
    - add_on : list of Ingredient [that can modify]
    + custom()
    + update_price()
}
class ChickenSet{
    
}
class Ingredient{
    - item : Item
    - quantity : int
}
class Item{
    - name : string
    - price : float
}

Restaurant o-- MenuFood
MenuFood --> Particular
class MenuFood{
    - particular : Particular
    - status : available, out_of_stock, deleted
    + update_status(MenuFoodStatus)
}

Restaurant --> Stock
Item --o Stock
class Stock{
    - reserved_stock : list of Item
    - real_stock : list of Item
    + find_ingredient_in_reserved(Ingredient)
    + find_ingredient_in_real_stock(Ingredient)
}

FixedAmountCoupon --|> Coupon
PercentCoupon --|> Coupon
EventOrder --* Booking

Coupon --o Restaurant
class Room{
    - room_id : str
    - name : str
    - status : RoomStatus
    - capacity : int
    - price_per_hour : float
    + update_status(RoomStatus)
}
Restaurant o-- Room
Restaurant o-- Booking
Booking *-- TimeSlot
class Booking{
    - booking_id : str
    - member : Member
    - room : Room
    - time_slot : TimeSlot
    - status : BookingStatus
    - total_price : float
    - deposit_price : float
    - deposit_status : str = "Unpaid", "Paid", "Seized"
    + add_event_order(EventOrder)
    + add_time_slot(room, start_time, hours)
    + get_details() : Dict<str, Any>
}
class TimeSlot{
    - start_time : datetime
    - end_time : datetime
    - hours : int
}
abstract class Coupon{
    - id : str
    - code : str
    - minimum_price : float
    - status : CouponStatus
    + {abstract} apply_coupon(base_price: float) : float
    + is_applicable(base_price: float) : bool
    + mark_as_used()
}
class PercentCoupon{
    - percent : int
    + apply_coupon(base_price: float)
}
class FixedAmountCoupon{
    - amount : float
    + apply_coupon(base_price: float)
}

DeliveryPlatform <-- Restaurant
class DeliveryPlatform{
    - platform_name : str
    - commission_rate : float
}
PaymentStrategy <-- Restaurant
abstract class PaymentStrategy{
    - id : str
    - name : str
    + get_strategy(name:str)
    + get_name() : abstract
    + {abstract} pay(amount: float, kwargs) : Tuple<bool, str, str>
}

QRCode --|> PaymentStrategy
class QRCode{

}

Cash --|> PaymentStrategy
class Cash{
    
}

CreditCard --|> PaymentStrategy
class CreditCard{
    
}

Member o-- Receipt
Receipt --> Transaction
Receipt --> Booking
class Receipt{
    - transaction : Transaction
    - source : Order
    + generate()
}

Restaurant o-- Transaction
PaymentStrategy <-- Transaction
Customer <-- Transaction
class Transaction{
    - id : str
    - order : Order
    - type : OrderType
    - customer : Customer
    - amount : float
    - time : datetime
    - payment_method : PaymentStrategy
    - coupon : Coupon
    - status : str
    + mark_success()
    + mark_failed()
}

Restaurant o-- StockLog
StockLog --> Staff
StockLog --> Ingredient
class StockLog{
    - id : str
    - staff : Staff
    - action : str
    - ingredient : Ingredient
}
class SimulationClock{
    - current_time : datetime
    + get_time()
    + set__time(new_time)
}

Restaurant o-- Simulation 
SimulationClock --> Simulation
class Simulation{
    - clock
    - delivery_platform
}

package "Enums" {
    enum OrderType {
        GENERAL
        DELIVERY
        EVENT
    }
    enum OrderStatus {
        PENDING
        PAID
        CANCELED
    }
    enum BookingStatus {
        PENDING
        DEPOSIT_PAID
        CHECKED_IN
        COMPLETED
    }
    enum RoomStatus {
        AVAILABLE
        RESERVED
        IN_USE
        CLEANING
    }
    enum RoomType {
        VIP
        STANDARD
        HALL
    }
    enum MemberTier {
        BRONZE
        SILVER
        GOLD
    }
    enum CouponStatus {
        AVAILABLE
        NOT_AVAILABLE
    }
    enum StaffRole {
        PartyStaff
        KitchenStaff
    }
    enum TransactionStatus {
        PENDING
        FAILED
        SUCCESS
    }
}

@enduml
