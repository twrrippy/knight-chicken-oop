@startuml ClassDiagram

class Restaurant{
    - member : list of Member
    - order_list : list of Order <in comfirm, paided, and cooking state>
    - coupon_list : list of Coupon
    - stock_log : list of StockLog
    - transaction_log : list of Transaction
    - room : list of Room
    - staff : list of Staff
    - stock : Stock
    - menu : list of MenuFood
    - payment_gateway : PaymentGateway
    - delivery_platform : DeliveryPlatform
    - booking_list : list of Booking
    + add_coupon(Coupon)
    + get_coupon_by_code(code)
    - create_transaction()
    + booking_room(staff_id, member_id, room_id, amount_paid, start_time, hours)
    + add_booking()
    + is_slot_available()
    + auto_check_no_show()
    + get_bookings_by_status(status): List[Booking]
    + get_booking_by_id(booking_id)
}
Customer --|> User
Staff --|> User
class User{
    - id : string
    - name : string
    - phoneNumber : string
    + get_id()
}
Restaurant o-- Member
Member--|>Customer
Guest--|>Customer
class Customer {
    <<Abstract>>
    + request_bill()
}
class Guest {
    + register()
}
class Member{
    - coupon_code_list : list
    - receipt_list : list
    - tier : str= Silver, Gold
    + add_receipt(receipt)
    + add_coupon(code)
    + validate_coupon(code)
    + mark_coupon_as_used(code)
}

Restaurant o-- Staff
FrontStaff--|>Staff
PartyStaff--|>Staff
KitchenStaff--|>Staff
Manager--|>FrontStaff
Manager--|>PartyStaff
Manager--|>KitchenStaff
class Staff{
    <<Abstract>>
    - username
    - password
    + login()
    + logout()
}
class FrontStaff{
    + create_order()
    
}
class PartyStaff{
    + check_room_availability()
    + check_in_booking()
    + check_out_booking()
}
class KitchenStaff{
    + view_queue()
    + update_food_status()
    + report_waste()   
}
class Manager{
    + void_bill()
}

DineInOrder --|> Order
EventOrder --|> Order
DeliveryOrder --|> Order

class DineInOrder{
    
}
class EventOrder{

}
class DeliveryOrder{
    - delivery_status : finding_driver, driver_assigned, driver_at _store, out_for_delivery, delivered
    + update_status(DeliveryStatus)
}

Restaurant o-- Order
Order *-- Food
Order --> Customer
Food --> Particular
Particular o-- Ingredient
Ingredient --> Item

class Order{
    - id:  string
    - type : DineIn, Event, Delivery
    - customer : Customer
    - food_list : list Food
    - total_price : float
    - status_start : datetime
    - status : none, reserved, confirmed, paided, cooking, finish, served, cancle
    + update_status(OrderStatus)
}
class Food{
    - particular : Particular
    - quantity : int
    - status : none, available, out_of_stock, cooking, finish, cancle
    + update_status(FoodStatus)
}
class Particular{
    - name : str
    - recipe : list of Ingredient
    - price : float
    - cooking_time : datetime
    + get_all_ingredient()
}
Burger --|> Particular
ChickenSet --|> Particular
class Burger{
    - add_on : list of Ingredient [that can modify]
    + custom()
    + update_price()
}
class ChickenSet{
    
}
class Ingredient{
    - item : Item
    - quantity : int
}
class Item{
    - name : string
    - price : float
}

Restaurant o-- MenuFood
MenuFood --> Particular
class MenuFood{
    - particular : Particular
    - status : available, out_of_stock, deleted
    + update_status(MenuFoodStatus)
}

Restaurant --> Stock
Item --o Stock
class Stock{
    - reserved_stock : list of Item
    - real_stock : list of Item
    + find_ingredient_in_reserved(Ingredient)
    + find_ingredient_in_real_stock(Ingredient)
}

PercentCoupon --|> Coupon
EventOrder --* Booking

Coupon --o Restaurant
class Room{
    - room_id : str
    - name : str
    - status : str = "Available", "In_Use", "Cleaning"
    - capacity : int
    - price_per_hour : float
    + update_status(RoomStatus)
}
Restaurant o-- Room
Restaurant o-- Booking
Booking *-- TimeSlot
class Booking{
    - booking_id : str
    - member : Member
    - room : Room
    - time_slot : TimeSlot
    - status : str = "Pending", "Reserved", "In-Use", "Completed", "Cancelled_NoShow"
    - event_order : EventOrder
    - discount_price : float
    - total_price : float
    - deposit_price : float
    - deposit_status : str = "Unpaid", "Paid", "Seized"
    + add_event_order(EventOrder)
    + add_time_slot(room, start_time, hours)
    + calculate_payment_details()
    + get_member()
    + get_event_order()
}
class TimeSlot{
    - start_time : datetime
    - end_time : datetime
    - hours : int
}
class Coupon{
    <<Abstract>>
    - id : str
    - code : str
    - minimum_price : float
    + apply_coupon(base_price)
    + is_applicable(base_price)
}
class PercentCoupon{
    - percent : int
}
DeliveryPlatform <-- Restaurant
class DeliveryPlatform{
    - platform_name : str
    - commission_rate : float
}
PaymentGateway <-- Restaurant
class PaymentGateway{
    + get_strategy(name:str)
    + get_name() : abstract
    + pay() : abstract
}

QRCode --|> PaymentGateway
class QRCode{

}

Cash --|> PaymentGateway
class Cash{
    
}

CreditCard --|> PaymentGateway
class CreditCard{
    
}

Member o-- Receipt
Receipt --> Transaction
Receipt --> Booking
class Receipt{
    - transaction : Transaction
    - source : source_obj
    + generate()
    + get_strategy(name:str)
}

Restaurant o-- Transaction
PaymentGateway <-- Transaction
Customer <-- Transaction
class Transaction{
    - type : DineIn, Event, Delivery
    - customer : Customer
    - amount : float
    - time : datetime
    - tx_id : str
    - payment_method : PaymentGateway
    - coupon : Coupon
    - status : str
}

Restaurant o-- StockLog
StockLog --> Staff
StockLog --> Ingredient
class StockLog{
    - id : str
    - staff : Staff
    - action : str
    - ingredient : Ingredient
}
class SimulationClock{
    - current_time : datetime
    + get_time()
    + set__time(new_time)
}

Restaurant o-- Simulation 
SimulationClock --> Simulation
class Simulation{
    - clock
    - delivery_platform
}

@enduml
