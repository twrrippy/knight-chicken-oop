Restaurant o-- Receipt
Member o-- Receipt
PaymentMethod <-- Receipt
Customer <-- Receipt
Order <-- Receipt
class Receipt{
    - id : str
    - order : Order
    - method : PaymentMethod
    - timestamp : datetime
    + generate() : dict
    + {property} id() : str
    + {property} order() : Order
    + {property} method() : PaymentMethod
    + {property} timestamp() : datetime
}

Session --o AuthManager
Restaurant --> AuthManager
class Session{
    - token : str
    - user_id : str
    - login_time : datetime
    - is_active : bool
    + invalidate()
    + check_token(token: str) : bool
    + {property} is_active() : bool
    + {property} user_id() : str
    + {property} token() : str
}
class AuthManager{
    - sessions : list of Session
    + create_session(user_id: str) : Session
    + get_session(token: str) : Session | None
    + revoke_staff_sessions(user_id: str)
}

package "Enums" {
    enum OrderType {
        GENERAL
        DELIVERY
        EVENT
    }
    enum OrderStatus {
        PENDING
        RESERVED
        CONFIRMED
        PAID
        COOKING
        READY
        SERVED
        CANCELED
    }
    enum OrderItemStatus{
        PENDING
        ADDED
        RESERVED
        OUT_OF_STOCK
        COOKING
        READY
        SERVED
        CANCELED
    }
    enum MenuItemStatus{
        AVAILABLE
        UNAVAILABLE
    }
    enum IngredientType{
        STRICT
        CUSTOMIZABLE
    }
    enum BookingStatus {
        PENDING
        DEPOSIT_PAID
        PAID
        CHECKED_IN
        COMPLETED
        CANCELED
    }
    enum RoomStatus {
        AVAILABLE
        IN_USE
        CLEANING
    }
    enum RoomType {
        VIP
        STANDARD
        HALL
    }
    enum MemberTier {
        GENERAL
        BRONZE
        SILVER
        GOLD
    }
    enum CouponStatus {
        AVAILABLE
        NOT_AVAILABLE
    }
    enum DeliveryStatus{
        PENDING
        PAID
        DRIVER_ASSIGNED
        IN_TRANSIT
        DELIVERED
        CANCELED
    }
    enum UserRole {
        ADMIN
        STAFF
        MEMBER
        GUEST
    }
    enum PlatformName{
        GRAB
        LINE_MAN
        SHOPEE_FOOD
    }
    enum TransactionStatus{
        PENDING
        FAILED
        SUCCESS
    }
    enum ItemStatus{
        AVAILABLE
        RESERVED
    }

}

